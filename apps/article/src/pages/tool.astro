---
/**
 * The standalone tool, at /tool/.
 *
 * `client:load` rather than `client:visible`: the whole page is the island, so
 * there is nothing to see before it hydrates and deferring only adds a blank
 * frame. The article's figures are the opposite case and stay lazy.
 */
import '../styles/article.css'
import '../styles/tool.css'
import SiteHead from '../components/SiteHead.astro'
import { Playground } from '../components/Playground.tsx'

const title = 'Optimization kangaroos — the tool'
const description =
  'Every algorithm from the article, on every landscape, with every parameter exposed.'
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} />
  </head>
  <body class="tool-body">
    <Playground client:load />
  </body>
</html>

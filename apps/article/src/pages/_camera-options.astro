---
/**
 * Camera contact sheet. Kept, not shipped.
 *
 * The leading underscore is what keeps Astro from building it, which also
 * means you cannot look at it without temporarily dropping the underscore:
 *
 *     mv _camera-options.astro camera-options.astro
 *     npm run build && npx serve dist    # /camera-options/
 *
 * Worth the friction. Rendering the same run from several directions side by
 * side is the only honest way to choose one — an angle that looks obviously
 * right on its own is usually just the one you saw most recently — and the
 * next time a figure needs a camera, the harness should already exist.
 *
 * Since the framing solve landed, the distance is no longer part of the
 * choice: every angle here is framed correctly, so what is being compared is
 * only what the landscape reads as. 45°/28° won and is the default, so nothing
 * in the article passes `camera` at all.
 */
import Article from '../layouts/Article.astro'
import { SearchFigure } from '../components/SearchFigure.tsx'

const ANGLES = [
  { azimuth: 45, elevation: 28, label: 'a — 45°/28° (the old default, fitted)' },
  { azimuth: 45, elevation: 42, label: 'b — 45°/42°' },
  { azimuth: 30, elevation: 20, label: 'c — 30°/20°' },
  { azimuth: 60, elevation: 34, label: 'd — 60°/34°' },
  { azimuth: 20, elevation: 55, label: 'e — 20°/55°' },
  { azimuth: 0, elevation: 24, label: 'f — 0°/24°, square on' },
]
---

<Article title="Camera options" description="Contact sheet">
  <div class="prose">
    <h1>Act one camera</h1>
  </div>
  {
    ANGLES.map((a) => (
      <div class="wide">
        <SearchFigure
          client:visible
          surface="Himmelblau"
          algorithm="hill-climber"
          seed={7}
          startX={-0.6}
          startY={-1.2}
          trailWidth={2}
          showProbes
          camera={{ azimuth: a.azimuth, elevation: a.elevation }}
          caption={a.label}
        />
      </div>
    ))
  }
</Article>

---
import '../styles/article.css'
import SiteHead from '../components/SiteHead.astro'

// A Markdown/MDX page that sets `layout:` does NOT get its frontmatter spread
// onto Astro.props — it arrives as Astro.props.frontmatter. Reading the keys
// directly is why every built page shipped an empty <title> and an empty
// description. The direct-prop fallback keeps this layout usable from a plain
// .astro page that passes props the ordinary way.
interface Props {
  frontmatter?: { title?: string; description?: string }
  title?: string
  description?: string
}
const { frontmatter } = Astro.props
const title = frontmatter?.title ?? Astro.props.title ?? ''
const description = frontmatter?.description ?? Astro.props.description ?? ''
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} datePublished="2026-08-01" />
    <!--
      No Google Fonts link. The two faces are subset and served from this
      origin — see `tools/fetch-fonts.mjs` and `src/styles/fonts.css`. The
      landing page loads them from the CDN; a 2500-word article should not
      have its typeface depend on a third party being reachable.
    -->
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
